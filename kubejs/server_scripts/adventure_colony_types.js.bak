// adventure_colony_types.js
// Place in: <instance>\kubejs\server_scripts\adventure_colony_types.js
// DELETE the older adventure_starter.js, or both scripts will fire on login.
// Target: Minecraft 1.21.1, NeoForge, KubeJS 2101.7.x
//
// How the player picks a colony type (all three routes end in the same command):
//   1. Chat menu: on login the player sees clickable [Farming] [Mining] [Forest].
//      Clicking runs /colonytype <type>.
//   2. Typing /colonytype <type> by hand. It needs no operator permission.
//   3. FTB Quests: make a quest with a Choice reward whose entries are
//      Command rewards (/colonytype farming, /colonytype mining, ...),
//      permission level 0. This script's command does the rest.
//
// A /trigger scoreboard route is NOT included: /colonytype is already usable
// by normal players, so it would add nothing.
//
// The Supply Camp or Ship chest should already contain the Town Hall and a
// Build Tool (per the MineColonies Getting Started page), so this script does
// not give those. Set GIVE_TOWNHALL_AND_TOOLS to true if your pack's camp
// turns out to be empty.
//
// UNVERIFIED (check in-game; the script reports bad item IDs in chat):
//   - minecolonies:blockhutfarmer, minecolonies:blockhutminer,
//     minecolonies:supplycampdeployer, minecolonies:blockhuttownhall,
//     structurize:build_tool, structurize:scan_tool
//   - Whether can_place_on is respected by hut items, which are normally
//     placed through the Build Tool GUI. That is the Adventure Mode test.
//
// After editing: /kubejs reload server_scripts

const GIVE_TOWNHALL_AND_TOOLS = false

const KIT_STAGE = 'colony_type_chosen'

const PLACEABLE_ON =
  '{predicates:[{blocks:["#minecraft:dirt","#minecraft:sand","#minecraft:base_stone_overworld","#minecraft:snow"]}],show_in_tooltip:false}'

// Items every colony type receives.
const COMMON_ITEMS = [
  { id: 'minecolonies:supplycampdeployer', count: 1, placeable: true },
  { id: 'minecraft:bread', count: 16, placeable: false },
  { id: 'minecraft:torch', count: 16, placeable: false },
]

const TOWNHALL_AND_TOOLS = [
  { id: 'minecolonies:blockhuttownhall', count: 1, placeable: true },
  { id: 'structurize:build_tool', count: 1, placeable: false },
  { id: 'structurize:scan_tool', count: 1, placeable: false },
]

// The three colony types. Edit freely.
// Each type has five starting hut items plus themed materials.
const TYPES = {
  farming: {
    label: 'Farming Valley',
    blurb: 'Food-first start: Farmer and Cook, plenty of seeds and bread.',
    items: [
      { id: 'minecolonies:blockhutbuilder', count: 1, placeable: true },
      { id: 'minecolonies:blockhutcitizen', count: 1, placeable: true },
      { id: 'minecolonies:blockhutfarmer', count: 1, placeable: true },
      { id: 'minecolonies:blockhutlumberjack', count: 1, placeable: true },
      { id: 'minecolonies:blockhutcook', count: 1, placeable: true },
      { id: 'minecraft:wheat_seeds', count: 32, placeable: false },
      { id: 'minecraft:bread', count: 32, placeable: false },
      { id: 'minecraft:stone_hoe', count: 2, placeable: false },
      { id: 'minecraft:oak_planks', count: 64, placeable: false },
      { id: 'minecraft:cobblestone', count: 32, placeable: false },
    ],
  },
  mining: {
    label: 'Mining Outpost',
    blurb: 'Stone-first start: a Miner with everything the shaft needs.',
    items: [
      { id: 'minecolonies:blockhutbuilder', count: 1, placeable: true },
      { id: 'minecolonies:blockhutcitizen', count: 1, placeable: true },
      { id: 'minecolonies:blockhutminer', count: 1, placeable: true },
      { id: 'minecolonies:blockhutlumberjack', count: 1, placeable: true },
      { id: 'minecolonies:blockhutfarmer', count: 1, placeable: true },
      { id: 'minecraft:cobblestone', count: 128, placeable: false },
      { id: 'minecraft:oak_planks', count: 64, placeable: false },
      { id: 'minecraft:oak_fence', count: 32, placeable: false },
      { id: 'minecraft:torch', count: 48, placeable: false },
      { id: 'minecraft:stone_pickaxe', count: 2, placeable: false },
      { id: 'minecraft:stone_shovel', count: 2, placeable: false },
    ],
  },
  forest: {
    label: 'Forest Settlement',
    blurb: 'Wood-first start: Lumberjack and Sawmill, logs and planks.',
    items: [
      { id: 'minecolonies:blockhutbuilder', count: 1, placeable: true },
      { id: 'minecolonies:blockhutcitizen', count: 1, placeable: true },
      { id: 'minecolonies:blockhutlumberjack', count: 1, placeable: true },
      { id: 'minecolonies:blockhutsawmill', count: 1, placeable: true },
      { id: 'minecolonies:blockhutfarmer', count: 1, placeable: true },
      { id: 'minecraft:oak_log', count: 64, placeable: false },
      { id: 'minecraft:oak_planks', count: 128, placeable: false },
      { id: 'minecraft:stone_axe', count: 2, placeable: false },
      { id: 'minecraft:cobblestone', count: 32, placeable: false },
    ],
  },
}

function buildStack(entry) {
  const spec = entry.placeable
    ? `${entry.id}[can_place_on=${PLACEABLE_ON}]`
    : entry.id
  return Item.of(spec, entry.count)
}

function giveAll(player, list, failed) {
  list.forEach((entry) => {
    let stack
    try {
      stack = buildStack(entry)
    } catch (e) {
      failed.push(entry.id)
      return
    }
    if (stack.isEmpty()) {
      failed.push(entry.id)
      return
    }
    player.give(stack)
  })
}

// Clickable chat menu, sent with vanilla /tellraw (1.21.1 JSON format).
function showMenu(player) {
  const parts = [
    '',
    { text: '[Colony type] Choose how your colony starts:\n', color: 'gold' },
  ]
  Object.keys(TYPES).forEach((key) => {
    const t = TYPES[key]
    parts.push({
      text: `[${t.label}]  `,
      color: 'green',
      clickEvent: { action: 'run_command', value: `/colonytype ${key}` },
      hoverEvent: { action: 'show_text', contents: { text: t.blurb } },
    })
  })
  player.server.runCommandSilent(
    `tellraw ${player.username} ${JSON.stringify(parts)}`
  )
}

function choose(player, key) {
  if (!player) return 0
  if (player.stages.has(KIT_STAGE)) {
    player.tell('[Colony type] You have already chosen. Ask an operator to reset you.')
    return 0
  }
  const type = TYPES[key]
  if (!type) return 0

  player.stages.add(KIT_STAGE)

  // Force Adventure Mode. On a dedicated server, also set force-gamemode=true
  // and gamemode=adventure in server.properties.
  player.server.runCommandSilent(`gamemode adventure ${player.username}`)

  const failed = []
  giveAll(player, COMMON_ITEMS, failed)
  if (GIVE_TOWNHALL_AND_TOOLS) giveAll(player, TOWNHALL_AND_TOOLS, failed)
  giveAll(player, type.items, failed)

  player.tell(`[Colony type] ${type.label} chosen. Place the Supply Camp to begin.`)
  if (failed.length > 0) {
    player.tell(`[Colony type] These items could not be created (check the IDs): ${failed.join(', ')}`)
  }
  return 1
}

// Show the menu until a type has been chosen.
PlayerEvents.loggedIn((event) => {
  const player = event.player
  if (player.stages.has(KIT_STAGE)) return
  showMenu(player)
})

ServerEvents.commandRegistry((event) => {
  const { commands: Commands } = event

  // /colonytype            -> show the menu again
  // /colonytype <type>     -> choose a type (no operator permission needed)
  let root = Commands.literal('colonytype').executes((c) => {
    if (c.source.player) showMenu(c.source.player)
    return 1
  })
  Object.keys(TYPES).forEach((key) => {
    root = root.then(
      Commands.literal(key).executes((c) => choose(c.source.player, key))
    )
  })
  event.register(root)

  // /colonytypereset (operators only): lets a tester choose again.
  event.register(
    Commands.literal('colonytypereset')
      .requires((s) => s.hasPermission(2))
      .executes((c) => {
        const player = c.source.player
        if (!player) return 0
        player.stages.remove(KIT_STAGE)
        player.tell('[Colony type] Reset. Run /colonytype to choose again.')
        return 1
      })
  )
})
